{
  "expo": {
    "name": "TáNaLista",
    "slug": "tanalista",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tanalista",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.tanalista"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1A14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.tanalista"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1A14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "maluf",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "707d3027-25de-4e26-b802-1027c28a9254"
      }
    }
  }
}
