{
  "expo": {
    "name": "TáNaLista",
    "slug": "tanalista",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tanalista",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.tanalista",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1A14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.tanalista",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1A14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "O TáNaLista usa suas fotos para você escolher a foto de perfil e enviar fotos dos eventos.",
          "cameraPermission": "O TáNaLista usa a câmera para você tirar a foto de perfil e fotos dos eventos."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "O TáNaLista adiciona ao seu calendário os eventos que você escolher."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O TáNaLista usa a câmera para ler o QR code dos ingressos no check-in e para você tirar fotos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4ADE80"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "maluf",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "707d3027-25de-4e26-b802-1027c28a9254"
      }
    }
  }
}
