EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL do site (Next.js), que serve a API /api/v1
EXPO_PUBLIC_API_URL=
# Mostra "Continuar com Apple" no login. Ligue (1) só depois de ativar a Apple
# no Supabase (Authentication > Sign In / Providers > Apple).
EXPO_PUBLIC_APPLE_SIGN_IN=
# Captcha (Turnstile) nas telas de entrar, criar conta e recuperar senha (1 liga).
# A página /embed/captcha do site gera o token; sem a chave do Turnstile no site,
# o app segue sem token.
EXPO_PUBLIC_CAPTCHA=
